RPC_URL=https://api.mainnet-beta.solana.com
WALLET_PRIVATE_KEY=
PORT=3000

# Required - launched-token/config records live here (see src/db.js), not
# in flat JSON files anymore. Local dev: point at any local Postgres
# (e.g. a throwaway Docker container). Production (Railway): add the
# Postgres plugin and it injects this automatically.
DATABASE_URL=postgres://postgres:password@localhost:5432/dbc_launchpad

# Optional - only needed for the Pyth-anchored curve presets (see
# src/pythPricing.js). Get a free key at pythdata.app. Without it, the app
# still runs fine with just the two fixed SOL presets.
PYTH_API_KEY=
